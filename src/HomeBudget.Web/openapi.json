{
  "openapi": "3.1.1",
  "info": {
    "title": "Home Budget API",
    "description": "API REST de Home Budget. Les requ\u00EAtes POST/PUT/PATCH/DELETE exigent l\u0027en-t\u00EAte X-CSRF-TOKEN.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/setup/status": {
      "get": {
        "tags": [
          "Setup"
        ],
        "summary": "Indique si le premier administrateur reste \u00E0 cr\u00E9er.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup": {
      "post": {
        "tags": [
          "Setup"
        ],
        "summary": "Cr\u00E9e le premier administrateur (jeton de premier lancement requis).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdminRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Jeton anti-CSRF \u00E0 renvoyer dans l\u0027en-t\u00EAte X-CSRF-TOKEN.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfToken"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Utilisateur connect\u00E9.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Connexion par identifiant et mot de passe.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login/two-factor": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Seconde \u00E9tape de connexion : code TOTP.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TwoFactorLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login/recovery-code": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Seconde \u00E9tape de connexion : code de secours.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryCodeLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "D\u00E9connexion.",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/account/two-factor": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "\u00C9tat de la double authentification.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwoFactorStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/two-factor/setup": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "G\u00E9n\u00E8re une nouvelle cl\u00E9 TOTP (\u00E0 scanner dans l\u0027application d\u0027authentification).",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatorSetup"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/two-factor/enable": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Active la double authentification apr\u00E8s v\u00E9rification d\u0027un code ; renvoie les codes de secours.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnableTwoFactorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodes"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/two-factor/disable": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "D\u00E9sactive la double authentification (mot de passe requis).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordConfirmation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/account/two-factor/recovery-codes": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "R\u00E9g\u00E9n\u00E8re les codes de secours (mot de passe requis).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordConfirmation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodes"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthenticatorSetup": {
        "required": [
          "sharedKey",
          "authenticatorUri"
        ],
        "type": "object",
        "properties": {
          "sharedKey": {
            "type": "string"
          },
          "authenticatorUri": {
            "type": "string"
          }
        }
      },
      "CreateAdminRequest": {
        "required": [
          "token",
          "userName",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "userName": {
            "maxLength": 64,
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": "string"
          }
        }
      },
      "CsrfToken": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "CurrentUser": {
        "required": [
          "id",
          "userName",
          "email",
          "roles",
          "twoFactorEnabled"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "twoFactorEnabled": {
            "type": "boolean"
          }
        }
      },
      "EnableTwoFactorRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "LoginResponse": {
        "required": [
          "status",
          "user"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/LoginStatus"
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentUser"
              }
            ]
          }
        }
      },
      "LoginStatus": {
        "enum": [
          "Succeeded",
          "RequiresTwoFactor"
        ]
      },
      "PasswordConfirmation": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "RecoveryCodeLoginRequest": {
        "required": [
          "recoveryCode"
        ],
        "type": "object",
        "properties": {
          "recoveryCode": {
            "type": "string"
          }
        }
      },
      "RecoveryCodes": {
        "required": [
          "codes"
        ],
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SetupStatus": {
        "required": [
          "required"
        ],
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          }
        }
      },
      "TwoFactorLoginRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "TwoFactorStatus": {
        "required": [
          "enabled",
          "recoveryCodesLeft"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "recoveryCodesLeft": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Setup"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Account"
    }
  ]
}
